&aed_models
   models =
   'aed_sedflux',
   'aed_seddiagenesis'
/
&aed_sedflux
   sedflux_model = 'Constant2D'
/
&aed_sed_const2d
   n_zones = 1
   active_zones = 1
   Fsed_oxy = -44
   Fsed_ch4 = 15
   Fsed_amm =  2.848790019
   Fsed_nit = -0.01
   Fsed_frp = 0.0048
/
!###############################################################################
! aed_sed_candi
!-------------------------------------------------------------------------------
&aed_sediment
   sediment_model = 'DYNAMIC'
/
&aed_sed_candi
 !-- Time things --!
   driver_dt   = 3600
   substep     = 24
 !-- Zones details  --!
   n_zones =   1
   active_zones = 1
   zone_types   = 1
 !-- General setup options  --!
   dbase        = 'aed_sdg/aed_candi_params.csv'
   vars_files   = 'aed_sdg/aed_sdg_vars.csv'
   geochem_file = 'aed_sdg/aed_geochem_pars.dat'
 !-- Boundary Conditions  --!
  swibc_mode = 10
  deepbc_mode = 10
  swibc_file      = 'aed_sdg/swibc_centre.dat'
  !swibc_file     = 'aed_sdg/swibc_long.dat'
  !swibc_file     = 'aed_sdg/swibc.dat'
  swibc_filevars  = 'salinity','amm','oxy','frp','poml','pomr','so4','nit','no2','pomspecial'
  deepbc_file     = 'aed_sdg/BottomBC_zone8.dat'
  deepbc_filevars = 'pf',  'amm',   'nit',      'frp',  'no2',    'salinity', 'so4', 'dic' 
  flux_scale     = 1.0
 !-- Outputs  --!
   diag_level = 10
   output_profiles    =   .TRUE.
   morevariables      = 'porevol','wvel','uvel','ROMNO2toN2O','ROMNO2toNH4','reac_POML','RCalppt','RTSOX','RFeOX','RRootsO2','Rgpp','Rrsp','reac_O2','RO2', 'RNO3', 'RNO2','RN2O','ROMO2', 'ROMNO3', 'ROMNO2','ROMN2O', 'ROMFeOH','ROMMnO2', 'ROMSO4','ROMMet','TerminalOxidation','MaxTerminalOxidation','TerminalOxidationPerPOC','TerminalOxidationPerTEA','FO2','FN2O','FNO3','FNO2','FMnO2','FFeOH','FSO4','FMet','RTDIC','RDIC','RCO2', 'NH4release','RNH4ads','FSal','FSul','FTEA_O2','FIN_N2O','FTEA_NO3','FTEA_NO2','FTEA_N2O','rnitrousation','rnitritation','RNO2O2','rnh4no2'
   output_diag_vars   = 'oxy'
   n_ddpths           = 1
   output_diag_depths = 1.0
 !-- Initial Conditions  --!
   OM_minR = 0.01
   InitMinDepthR = 25
   OM_minL = 0.05
   InitMinDepthL = 12
   MnFe_min = 0.05
   InitMinDepthMnFe = 15
   InitMinDepthN = 15
   InitMinDepthFeS = 35
   FeSInitMethod = 'I_DEP'
   SidInitMethod = 'I_SWI'
/
