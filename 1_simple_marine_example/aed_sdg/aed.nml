&aed_models
   models =
   'aed_sedflux',
   'aed_seddiagenesis'
/
&aed_sedflux
   sedflux_model = 'Constant2D'
/
&aed_sed_const2d
   n_zones = 1
   active_zones = 1
   Fsed_oxy = -44
   Fsed_ch4 = 15
   Fsed_amm =  2.848790019
   Fsed_nit = -0.01
   Fsed_frp = 0.0048
/
!###############################################################################
! aed_sed_candi
!-------------------------------------------------------------------------------
&aed_sediment
   sediment_model = 'DYNAMIC'
/
&aed_sed_candi
 !-- Time things --!
   substep     = 240    
 !-- Zones details  --!
   n_zones =   1
   active_zones = 1
   zone_types   = 1
 !-- General setup options  --!
   dbase        = 'aed_sdg/aed_candi_params.csv'
   vars_files   = 'aed_sdg/aed_sdg_vars.csv'
   geochem_file = 'aed_sdg/aed_geochem_pars.dat'
 !-- Boundary Conditions  --!
  swibc_mode = 0
 !-- Outputs  --!
   diag_level = 10
   output_profiles    =   .TRUE.
   morevariables      = ''
   output_diag_vars   = 'oxy'
   n_ddpths           = 1
   output_diag_depths = 1.0
 !-- Initial Conditions  --!
   OM_minR = 0.05
   InitMinDepthR = 14
   OM_minL = 0.05
   InitMinDepthL = 12

/
